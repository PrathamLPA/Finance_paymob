# Copy ALL of these into Railway → Backend service → Variables
# (The 4 URL vars alone are not enough — you also need DATABASE_URL + Paymob + Bitrix)

PUBLIC_BASE_URL=https://b2c-finance-and-ops-backend-production.up.railway.app
PAYMENT_FRONTEND_BASE_URL=https://financepaymob-frontend-production.up.railway.app
FRONTEND_ORIGIN=https://financepaymob-frontend-production.up.railway.app

DATABASE_URL=<your-supabase-pooler-url>
USE_MOCK_INTEGRATIONS=false

BITRIX24_WEBHOOK_URL=<from-local-.env>
BITRIX_WEBHOOK_SECRET=<from-local-.env>
# Lead convert-to-deal picker: Sales (not Old Leads / Operations / …)
BITRIX_SALES_PIPELINE_ID=16
BITRIX_FINANCE_GENERATE_LINK_STAGE_ID=C38:1
BITRIX_FINANCE_THRESHOLD_MET_STAGE_ID=<stage-id-after-required-payment>
BITRIX_FIELD_PAYMENT_LINK=UF_CRM_1783502165006
BITRIX_FIELD_CUSTOMER_EMAIL=UF_CRM_1724931551
BITRIX_FIELD_PAYMENT_PERCENTAGE=<optional-uf-field>
BITRIX_FIELD_PAYMENT_STATUS=<optional-uf-field>
BITRIX_FIELD_TRANSACTION_ID=<optional-uf-field>
# Only needed if the lead amount lives in a custom field instead of OPPORTUNITY
BITRIX_FIELD_LEAD_AMOUNT=
# Lead Payment Section — first link uses Installment 1 when set; empty = full amount
BITRIX_FIELD_INSTALLMENT_COUNT=UF_CRM_1684374566210
BITRIX_FIELD_INSTALLMENT_1=UF_CRM_1684373954405
# Reserved for later due-date installment links
BITRIX_FIELD_INSTALLMENT_2=UF_CRM_1684380172
BITRIX_FIELD_INSTALLMENT_3=
BITRIX_FIELD_INSTALLMENT_4=
BITRIX_FIELD_INSTALLMENT_1_DATE=UF_CRM_1684373986749
BITRIX_FIELD_INSTALLMENT_2_DUE_DATE=UF_CRM_1684374142163
BITRIX_FIELD_INSTALLMENT_3_DUE_DATE=UF_CRM_1684374296635
BITRIX_FIELD_INSTALLMENT_4_DUE_DATE=UF_CRM_1684374497754
BITRIX_FIELD_PAYMENT_2_MODE=UF_CRM_1684374103659
BITRIX_FIELD_PAYMENT_3_MODE=UF_CRM_1684374256836
BITRIX_FIELD_PAYMENT_4_MODE=UF_CRM_1684374451274
# Require catalog products + min-price check, then auto-create Estimate before payment link
BITRIX_PRICE_GATE_ENABLED=true
# Fallback recipient when lead owner has no department manager
BITRIX_APPROVAL_FALLBACK_EMAIL=

# Manager discount approvals are emailed via SendGrid (Bitrix mail.message.send is not used)
SENDGRID_API_KEY=<from-sendgrid>
SENDGRID_FROM_EMAIL=finance@learnerspoint.org
SENDGRID_FROM_NAME=Learners Point Finance

PAYMOB_SECRET_KEY=<from-local-.env>
PAYMOB_PUBLIC_KEY=<from-local-.env>
PAYMOB_INTEGRATION_ID=45192
PAYMOB_HMAC_SECRET=<from-local-.env>
# Temporary until Paymob documents Intention body HMAC — verify via Transaction Inquiry
PAYMOB_HMAC_FALLBACK_TO_INQUIRY=true
PAYMOB_BASE_URL=https://uae.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://uae.paymob.com/unifiedcheckout/
# Set true only while debugging an HMAC mismatch — dumps the transaction object
LOG_PAYMOB_PAYLOADS=false

ZOHO_CLIENT_ID=<optional>
ZOHO_CLIENT_SECRET=<optional>
ZOHO_REFRESH_TOKEN=<optional>
ZOHO_ORGANIZATION_ID=<optional>

DEFAULT_CURRENCY=AED
TERMS_VERSION=1.1
STORAGE_PATH=/tmp/finance-storage
PAYMENT_REQUIRED_PERCENT=50
REMINDER_ENABLED=true
REMINDER_INTERVAL_HOURS=24
REMINDER_SCHEDULER_ENABLED=true

# After "for myself" payment success, thank-you links here
LMS_LOGIN_URL=https://learn.learnerspoint.org/auth/login?redirect=https%3A%2F%2Flearn.learnerspoint.org%2Fmy-classroom

# Frontend service — only this one:
# API_BASE_URL=https://b2c-finance-and-ops-backend-production.up.railway.app
