# Application
APP_NAME=Finance Automation
APP_ENV=development
LOG_LEVEL=INFO

# Backend API public URL (Bitrix outbound webhook + Paymob notification_url)
PUBLIC_BASE_URL=http://localhost:8001

# Frontend payment pages (customer links + Paymob redirect thank-you)
PAYMENT_FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Frontend service only — URL of the backend API
API_BASE_URL=http://127.0.0.1:8001

# Database
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance_automation

# Integrations (mock by default for prototype)
USE_MOCK_INTEGRATIONS=true

# Bitrix24
BITRIX24_WEBHOOK_URL=
BITRIX_WEBHOOK_SECRET=
# Full "Track inbound webhook" URL; keep {{ID}} for runtime lead-id substitution.
BITRIX_INVOICE_SENT_TRIGGER_URL=
BITRIX_LEAD_PAYMENT_STAGE_ID=LEAD_PAYMENT
BITRIX_FINANCE_GENERATE_LINK_STAGE_ID=FINANCE_GENERATE_LINK
BITRIX_SALES_PIPELINE_ID=
BITRIX_FINANCE_PIPELINE_ID=
BITRIX_B2C_PIPELINE_ID=
# false = only convert lead→Sales; Finance/B2C come from Bitrix tunnel/copy
BITRIX_CREATE_EXTRA_DEALS_ON_PAYMENT=false
BITRIX_FIELD_INVOICE_REFERENCE=UF_CRM_INVOICE_REFERENCE
BITRIX_FIELD_INVOICE_URL=UF_CRM_INVOICE_URL
BITRIX_FIELD_AMOUNT_PAID=UF_CRM_AMOUNT_PAID
BITRIX_FIELD_REMAINING_BALANCE=UF_CRM_REMAINING_BALANCE
BITRIX_FIELD_TOTAL_AMOUNT=UF_CRM_TOTAL_AMOUNT
BITRIX_FIELD_PAYMENT_LINK=UF_CRM_PAYMENT_LINK
# Finance UF "Original Deal ID" → Sales deal id (bridge when Finance has no LEAD_ID)
BITRIX_FIELD_ORIGINAL_DEAL_ID=UF_CRM_64461C4D5CF41
BITRIX_FIELD_CUSTOMER_EMAIL=UF_CRM_CUSTOMER_EMAIL
BITRIX_FIELD_PAYMENT_PERCENTAGE=UF_CRM_PAYMENT_PERCENTAGE
BITRIX_FIELD_PAYMENT_STATUS=UF_CRM_PAYMENT_STATUS
BITRIX_FIELD_TRANSACTION_ID=UF_CRM_TRANSACTION_ID
BITRIX_FIELD_CUSTOMER_PHONE=UF_CRM_CUSTOMER_PHONE
BITRIX_FIELD_CUSTOMER_NAME=UF_CRM_CUSTOMER_NAME
# Custom field to read the amount from when OPPORTUNITY is empty
BITRIX_FIELD_LEAD_AMOUNT=
# Lead Payment Section — first payment link uses Installment 1 when set; empty = full
BITRIX_FIELD_INSTALLMENT_COUNT=UF_CRM_1684374566210
BITRIX_INSTALLMENT_COUNT_ENUM_MAP=5826:1,5828:2,5830:3,5832:4
BITRIX_FIELD_INSTALLMENT_1=UF_CRM_1684373846380
BITRIX_FIELD_INSTALLMENT_2=UF_CRM_1684380172
BITRIX_FIELD_INSTALLMENT_3=UF_CRM_1684380201
BITRIX_FIELD_INSTALLMENT_4=UF_CRM_1684380220
BITRIX_FIELD_INSTALLMENT_1_DATE=UF_CRM_1684373986749
BITRIX_FIELD_INSTALLMENT_2_DUE_DATE=UF_CRM_1684374296635
BITRIX_FIELD_INSTALLMENT_3_DUE_DATE=UF_CRM_1684374296635
BITRIX_FIELD_INSTALLMENT_4_DUE_DATE=UF_CRM_1684374497754
# Legacy Installment 2 Due Date (values copied into TEMP I2 field on convert)
BITRIX_FIELD_INSTALLMENT_2_DUE_DATE_LEGACY=UF_CRM_1684374142163
# Complete lead (CONVERTED) autofill — Learners Point form
BITRIX_COMPLETE_LEAD_AUTOFILL_ENABLED=true
BITRIX_FIELD_COMPLETE_SCHEDULE_FINALIZED=UF_CRM_1771500430277
BITRIX_FIELD_COMPLETE_PAID_AMOUNT=UF_CRM_1771500781458
BITRIX_FIELD_COMPLETE_TRAINER_SHARED=UF_CRM_1771501047627
BITRIX_FIELD_COMPLETE_OPS_NOTES=UF_CRM_1771501226065
BITRIX_FIELD_COMPLETE_STUDENT_NAME=UF_CRM_1771503330575
BITRIX_FIELD_COMPLETE_ENROLLMENT_DATE=UF_CRM_1771503410009
BITRIX_FIELD_COMPLETE_CREDIT_CARD=UF_CRM_1772016277089
BITRIX_FIELD_COMPLETE_TENURE=UF_CRM_1772019664771
BITRIX_FIELD_COMPLETE_STUDENT_TYPE=UF_CRM_1772454738552
BITRIX_FIELD_COMPLETE_BATCH_TYPE=UF_CRM_1772455024093
BITRIX_FIELD_COMPLETE_PAYMENT_PROOF=UF_CRM_1775466638710
# Lead "Paid Status": Fully Paid=19692, Partially Paid=19694
BITRIX_FIELD_COMPLETE_PAID_STATUS=UF_CRM_1789557091401
BITRIX_COMPLETE_PAID_STATUS_FULLY_PAID_ENUM=19692
BITRIX_COMPLETE_PAID_STATUS_PARTIALLY_PAID_ENUM=19694
# Finance deal "Proof of Next payment" — installment 2+ Zoho invoice PDF
BITRIX_FIELD_NEXT_PAYMENT_PROOF=UF_CRM_1789378609379
# Lead card "Invoice" multi-file tile field (Payment Section)
BITRIX_FIELD_LEAD_INVOICE_FILE=UF_CRM_1789204266156
BITRIX_FIELD_TOTAL_AMOUNT=UF_CRM_TOTAL_AMOUNT
# Lead Payment Section / Complete-lead "Total Amount_"
BITRIX_FIELD_LEAD_TOTAL_AMOUNT=UF_CRM_1684374599490
BITRIX_FIELD_COMPLETE_COMMENT_UF=UF_CRM_1684372587728
BITRIX_FIELD_TRAINING_MODE=UF_CRM_1684372786609
BITRIX_FIELD_COMPANY_WEBSITE=UF_CRM_1684388099787
BITRIX_FIELD_DESIGNATION=UF_CRM_1716456659309
BITRIX_FIELD_INDUSTRY_DOMAIN=UF_CRM_1749464475095
BITRIX_FIELD_DEPARTMENT_TRAINING=UF_CRM_1749464873149
BITRIX_FIELD_COURSE_DURATION=UF_CRM_1771238558828
BITRIX_FIELD_TRAINING_START_DATE=UF_CRM_1771238612202
BITRIX_FIELD_CLASS_TIMING=UF_CRM_1771238691110
BITRIX_FIELD_STUDY_MATERIALS=UF_CRM_1771240157159
BITRIX_FIELD_CERTIFICATES_PROMISED=UF_CRM_1771240323579
BITRIX_FIELD_MODE_OF_TRAINING=UF_CRM_1771499914629
BITRIX_COMPLETE_REQUIRED_STRING_FIELDS=UF_CRM_1684372587728,UF_CRM_1684388099787,UF_CRM_1716456659309,UF_CRM_1771238558828,UF_CRM_1771238691110,UF_CRM_1771240157159,UF_CRM_1771240323579
BITRIX_COMPLETE_REQUIRED_PLACEHOLDER=To be confirmed by Ops
BITRIX_COMPLETE_REQUIRED_SELECT_FIELDS=UF_CRM_1684372786609,UF_CRM_1749464475095,UF_CRM_1749464873149,UF_CRM_1771499914629
BITRIX_COMPLETE_COPY_PRODUCTS_TO_DEAL=true
BITRIX_COMPLETE_SCHEDULE_FINALIZED_ENUM=12912
BITRIX_COMPLETE_TRAINER_SHARED_ENUM=12916
BITRIX_COMPLETE_STUDENT_TYPE_ENUM=13198
BITRIX_COMPLETE_BATCH_TYPE_ENUM=13200
BITRIX_FIELD_PAYMENT_1_MODE=UF_CRM_1684373954405
BITRIX_FIELD_PAYMENT_2_MODE=UF_CRM_1684374103659
BITRIX_FIELD_PAYMENT_3_MODE=UF_CRM_1684374256836
BITRIX_FIELD_PAYMENT_4_MODE=UF_CRM_1684374451274
# Payment mode list enums (Cash=5786 skips Paymob and queues Cash Desk)
# Live Learners Point enums include: 5776 website payment, 5782 tabby, 5784 tamara, 5778 bank transfer, 13156 card
BITRIX_PAYMENT_MODE_ENUM_MAP=5774:cash,5786:cash,5776:website_payment,13234:website_payment,13156:card,5788:online,5778:bank_transfer,5790:bank_transfer,5782:tabby,5784:tamara,5780:purchase_order,13146:others,13178:bank_installment
# 5774 is the Cash option ID currently returned by Learners Point Bitrix
CASH_MODE_ENUM_IDS=5774,5786
# Bank Transfer: same payment link as online, then receipt upload + finance approval
BANK_TRANSFER_MODE_ENUM_IDS=5778,5790
BANK_TRANSFER_INSTRUCTIONS=Please transfer the amount to the Learners Point bank account, then upload a clear photo or PDF of the transfer receipt.
# Cash Desk staff auth (Next.js app in /cashdesk)
STAFF_JWT_SECRET=change-me-to-a-long-random-string
STAFF_JWT_TTL_HOURS=12
STAFF_BOOTSTRAP_MANAGER_EMAIL=
STAFF_BOOTSTRAP_MANAGER_PASSWORD=
STAFF_BOOTSTRAP_MANAGER_NAME=Cash Desk Manager
CASHDESK_ORIGIN=http://localhost:3000
# Same as FRONTEND_ORIGIN in production when Cash Desk is served at /cashdesk on the payment frontend
# When true: require lead products, compare selling vs catalog min, create Estimate
BITRIX_PRICE_GATE_ENABLED=true
# Bitrix mailbox sender used by mail.message.send (must be connected in Bitrix)
BITRIX_MAIL_FROM=
# If lead owner has no department manager, approvals go here
BITRIX_APPROVAL_FALLBACK_EMAIL=
BITRIX_FINANCE_THRESHOLD_MET_STAGE_ID=FINANCE_THRESHOLD_MET
# Temporary diagnostics only; fetched CRM payloads can contain customer PII
# Keep false in production — true dumps truncated CRM payloads at DEBUG
LOG_BITRIX_PAYLOADS=false

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# UAE Paymob integration IDs (Learners Point)
PAYMOB_INTEGRATION_ID=49586
PAYMOB_INTEGRATION_ID_CARD=49586
PAYMOB_INTEGRATION_ID_TABBY=52169
PAYMOB_INTEGRATION_ID_TAMARA=52266
PAYMOB_HMAC_SECRET=
# Temporary: confirm payments via Transaction Inquiry when Intention body HMAC fails
PAYMOB_HMAC_FALLBACK_TO_INQUIRY=true
PAYMOB_BASE_URL=https://uae.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://uae.paymob.com/unifiedcheckout/
# Temporary diagnostics — true dumps the transaction object when HMAC verification fails
LOG_PAYMOB_PAYLOADS=false

# Zoho Books — https://www.zoho.com/books/api/v3/oauth/
# Create a Server-based client at https://api-console.zoho.com/ (UAE: api-console.zoho.ae)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Data center must match your Zoho Books org:
#   Global: accounts.zoho.com + www.zohoapis.com/books/v3
#   UAE:    accounts.zoho.ae  + www.zohoapis.ae/books/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3
# Same redirect URI registered on the Zoho client (used by /api/dev/zoho/oauth-url)
ZOHO_OAUTH_REDIRECT_URI=https://b2c-finance-and-ops-backend-production.up.railway.app/api/dev/zoho/oauth-callback
ZOHO_OAUTH_SCOPES=ZohoBooks.contacts.CREATE,ZohoBooks.contacts.READ,ZohoBooks.invoices.CREATE,ZohoBooks.invoices.READ,ZohoBooks.invoices.UPDATE,ZohoBooks.customerpayments.CREATE,ZohoBooks.settings.READ
# Optional: existing Zoho Books item id for invoice line items
ZOHO_DEFAULT_ITEM_ID=

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=finance@example.com
SENDGRID_FROM_NAME=Finance Team

# Workflow
TERMS_VERSION=1.1
REFUND_POLICY_URL=https://financepaymob-frontend-production.up.railway.app/terms-and-conditions
PAYMENT_SESSION_TTL_HOURS=72
DEFAULT_CURRENCY=AED
STORAGE_PATH=storage
PAYMENT_REQUIRED_PERCENT=50
REMINDER_ENABLED=true
REMINDER_INTERVAL_HOURS=24
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_POLL_SECONDS=300
# Poller installment due emails — keep false when Bitrix BP Outbound webhook
# posts to /webhooks/bitrix24/installment-due (avoids double emails).
# Scheduler still refreshes expired payment links.
INSTALLMENT_DUE_NOTICES_ENABLED=false

# Bitrix BP Outbound webhook Handler (Installment 2 due − 1 day), example:
# {PUBLIC_BASE_URL}/webhooks/bitrix24/installment-due?deal_id={=Document:ID}&installment=2&token={BITRIX_WEBHOOK_SECRET}