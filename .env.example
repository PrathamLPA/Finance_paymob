BITRIX_FIELD_PAYMENT_4_MODE=UF_CRM_1684374451274
# Payment mode list enums (Cash=5786 skips Paymob and queues Cash Desk)
# Live Learners Point enums include: 5776 website payment, 5782 tabby, 5784 tamara, 5778 bank transfer, 13156 card
BITRIX_PAYMENT_MODE_ENUM_MAP=5774:cash,5786:cash,5776:website_payment,13234:website_payment,13156:card,5788:online,5778:bank_transfer,5790:bank_transfer,5782:tabby,5784:tamara,5780:purchase_order,13146:others,13178:bank_installment
# 5774 is the Cash option ID currently returned by Learners Point Bitrix
CASH_MODE_ENUM_IDS=5774,5786
# Bank Transfer: same payment link as online, then receipt upload + finance approval
BANK_TRANSFER_MODE_ENUM_IDS=5778,5790
BANK_TRANSFER_INSTRUCTIONS=Please transfer the amount to the Learners Point bank account, then upload a clear photo or PDF of the transfer receipt.
# Cash Desk staff auth (Next.js app in /cashdesk)
STAFF_JWT_SECRET=change-me-to-a-long-random-string
STAFF_JWT_TTL_HOURS=12
STAFF_BOOTSTRAP_MANAGER_EMAIL=
STAFF_BOOTSTRAP_MANAGER_PASSWORD=
STAFF_BOOTSTRAP_MANAGER_NAME=Cash Desk Manager
CASHDESK_ORIGIN=http://localhost:3000
# Same as FRONTEND_ORIGIN in production when Cash Desk is served at /cashdesk on the payment frontend
# When true: require lead products, compare selling vs catalog min, create Estimate
BITRIX_PRICE_GATE_ENABLED=true
# Catalog floor = MIN_PRICE type (not retail/BASE) — match Bitrix price type xmlId/name
BITRIX_CATALOG_MIN_PRICE_TYPE_XML_IDS=MIN_PRICE
BITRIX_CATALOG_MIN_PRICE_TYPE_NAMES=MIN_PRICE,Minimum,Min price,Minimum price,Min. price
# Bitrix mailbox sender used by mail.message.send (must be connected in Bitrix)
BITRIX_MAIL_FROM=
# If lead owner has no department manager, approvals go here
BITRIX_APPROVAL_FALLBACK_EMAIL=
BITRIX_FINANCE_THRESHOLD_MET_STAGE_ID=FINANCE_THRESHOLD_MET
# Temporary diagnostics only; fetched CRM payloads can contain customer PII
# Keep false in production — true dumps truncated CRM payloads at DEBUG
LOG_BITRIX_PAYLOADS=false

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# UAE Paymob integration IDs (Learners Point)
PAYMOB_INTEGRATION_ID=49586
PAYMOB_INTEGRATION_ID_CARD=49586
PAYMOB_INTEGRATION_ID_TABBY=52169
PAYMOB_INTEGRATION_ID_TAMARA=52266
PAYMOB_HMAC_SECRET=
# Temporary: confirm payments via Transaction Inquiry when Intention body HMAC fails
PAYMOB_HMAC_FALLBACK_TO_INQUIRY=true
PAYMOB_BASE_URL=https://uae.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://uae.paymob.com/unifiedcheckout/
# Temporary diagnostics — true dumps the transaction object when HMAC verification fails
LOG_PAYMOB_PAYLOADS=false

# Zoho Books — https://www.zoho.com/books/api/v3/oauth/
# Create a Server-based client at https://api-console.zoho.com/ (UAE: api-console.zoho.ae)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Data center must match your Zoho Books org:
#   Global: accounts.zoho.com + www.zohoapis.com/books/v3
#   UAE:    accounts.zoho.ae  + www.zohoapis.ae/books/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3
# Same redirect URI registered on the Zoho client (used by /api/dev/zoho/oauth-url)
ZOHO_OAUTH_REDIRECT_URI=https://b2c-finance-and-ops-backend-production.up.railway.app/api/dev/zoho/oauth-callback
ZOHO_OAUTH_SCOPES=ZohoBooks.contacts.CREATE,ZohoBooks.contacts.READ,ZohoBooks.invoices.CREATE,ZohoBooks.invoices.READ,ZohoBooks.invoices.UPDATE,ZohoBooks.customerpayments.CREATE,ZohoBooks.settings.READ
# Optional: existing Zoho Books item id for invoice line items
ZOHO_DEFAULT_ITEM_ID=
# Bitrix totals already include VAT — keep Zoho invoice total matching (e.g. 4.20 not 4.41)
ZOHO_INVOICE_IS_INCLUSIVE_TAX=true
# Optional Zoho tax_id so PDF still shows VAT split under inclusive rates
ZOHO_DEFAULT_TAX_ID=

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=finance@example.com
SENDGRID_FROM_NAME=Finance Team

# Workflow
TERMS_VERSION=1.1
REFUND_POLICY_URL=https://financepaymob-frontend-production.up.railway.app/terms-and-conditions
PAYMENT_SESSION_TTL_HOURS=72
DEFAULT_CURRENCY=AED
STORAGE_PATH=storage
PAYMENT_REQUIRED_PERCENT=50
REMINDER_ENABLED=true
REMINDER_INTERVAL_HOURS=24
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_POLL_SECONDS=300
# Poller installment due emails — keep false when Bitrix BP Outbound webhook
# posts to /webhooks/bitrix24/installment-due (avoids double emails).
# Scheduler still refreshes expired payment links.
INSTALLMENT_DUE_NOTICES_ENABLED=false

# Bitrix BP Outbound webhook Handler (Installment 2 due − 1 day), example:
# {PUBLIC_BASE_URL}/webhooks/bitrix24/installment-due?deal_id={=Document:ID}&installment=2&token={BITRIX_WEBHOOK_SECRET}